FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=80 \
    DB_PATH=/tmp/sppd.db

WORKDIR /app
COPY app.py index.html app.js style.css ./
RUN useradd --system --uid 10001 appuser && chown -R appuser:appuser /app

USER appuser
EXPOSE 80
CMD ["python", "app.py"]
